{
  "name": "forge-industrial-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start-local.mjs",
    "test": "node --test tests/server/*.test.mjs tests/orders/*.test.mjs server/live-runtime/*.test.mjs",
    "test:agh": "node --import ./integrations/agh/vendor-runtime/node_modules/tsx/dist/loader.mjs --test integrations/agh/*.test.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "setup": "node scripts/setup-local.mjs",
    "test:package": "node --test tests/packaging/*.test.mjs",
    "package": "npm run build && node scripts/package-submission.mjs",
    "export:records": "node tools/evaluation/export-agh-runs.mjs"
  },
  "dependencies": {
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "lucide-react": "1.53.0",
    "multer": "2.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  }
}
